MYSQL_ROOT_PASSWORD=local-dev-password
APP_PORT=8080
SHARE_TTL_SECONDS=604800
SHARE_CODE_MAX_FAILURES=5
SHARE_CODE_FAILURE_WINDOW_SECONDS=300
FASTDFS_PUBLIC_BASE_URL=http://localhost:8080/storage
# 仅在显式使用 `docker compose --profile ai` 时需要；不要提交真实密钥。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VISION_MODEL=qwen-vl-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
AI_CONTENT_MAX_RETRIES=5
AI_CONTENT_RETRY_SECONDS=15
AI_CONTENT_STALE_SECONDS=300
